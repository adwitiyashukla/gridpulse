# ---------------------------------------------------------------------------
# GridPulse configuration. Copy to .env and fill in.  cp .env.example .env
# ---------------------------------------------------------------------------

# REQUIRED. Free instant key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here

# OPTIONAL. Powers the natural-language "Ask the Grid" agent.
# Free instant key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Balancing authorities to ingest (comma separated EIA respondent codes).
# Default set spans distinct climates, sizes and generation mixes.
GRIDPULSE_BAS=PJM,MISO,ERCO,CISO,NYIS,ISNE,SWPP,BPAT,FPL,DUK,SOCO,TVA

# History window. EIA-930 hourly data begins 2015-07-01.
GRIDPULSE_START_DATE=2019-01-01

# Local paths (relative to repo root)
GRIDPULSE_DATA_DIR=data
GRIDPULSE_DUCKDB_PATH=data/gold/gridpulse.duckdb
GRIDPULSE_ARTIFACTS_DIR=artifacts

# Ingestion tuning. Lower these if you hit rate limits or low memory.
GRIDPULSE_MAX_CONCURRENCY=6
GRIDPULSE_PAGE_SIZE=5000
GRIDPULSE_REQUEST_TIMEOUT=60

# MLflow
MLFLOW_TRACKING_URI=file:./mlruns
